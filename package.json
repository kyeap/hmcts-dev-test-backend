{
  "name": "hmcts-dev-test-backend-node",
  "version": "0.0.1",
  "description": "HMCTS DTS developer challenge - task management API (Node/Express)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main/server.js",
    "start:dev": "nodemon --watch src/main --ext ts --exec ts-node src/main/server.ts",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "prettier --write . && eslint --fix .",
    "test": "jest",
    "test:unit": "jest src/test/unit",
    "test:routes": "jest src/test/routes",
    "test:coverage": "jest --coverage"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  }
}
